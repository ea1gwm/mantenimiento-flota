rules_version = '2';

// Mantenimiento de flota.
// Cada grupo que se sincroniza tiene un documento en 'flotas', cuyo id es
// el código que comparten los dispositivos. Las fotos de los recibos van
// en una subcolección aparte porque un documento de Firestore no puede
// pasar de 1 MB y una foto se come ese margen.
service cloud.firestore {
  match /databases/{database}/documents {

    match /flotas/{codigo} {
      allow read, write: if request.auth != null;

      match /fotos/{fotoId} {
        allow read, write: if request.auth != null;
      }
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
